# ---- Gemma 4 (Gemini API) ----
GEMMA_API_KEY=your_gemma_key
GEMMA_MODEL=gemma-4-26b-a4b-it

# ---- Firebase (leave blank to use the local data/db.json instead) ----
# Firestore storage: put the service-account file at ./firebase-service-account.json
#   (Firebase console > Project settings > Service accounts > Generate new private key)
#   or, on a host, paste the whole JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Auth (Google sign-in): Project settings > General > Your apps > Web app config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# ---- Server ----
PORT=3000
NEARBY_METERS=500
# optional: plain Google Identity Services instead of Firebase Auth
GOOGLE_CLIENT_ID=
